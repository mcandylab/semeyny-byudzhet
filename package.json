{
  "name": "semeyny-byudzhet",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "pb:install": "sh scripts/pocketbase-install.sh",
    "pb": "./pocketbase/pocketbase --dir pocketbase/pb_data --migrationsDir pocketbase/pb_migrations --hooksDir pocketbase/pb_hooks",
    "pb:serve": "npm run pb -- serve --http 127.0.0.1:8090",
    "legacy:migrate": "sh scripts/legacy-migrate.sh"
  },
  "dependencies": {
    "nuxt": "^4.7.0",
    "pocketbase": "^0.26.9",
    "vue": "^3.5.46",
    "vue-router": "^4.6.5"
  }
}
